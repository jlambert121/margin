# Generated application bundles, tests, screenshots, and compiler caches
/build/
/.build/
/DerivedData/

# Planning subprocess logs, checkpoints, and locks
/docs/tasks/*/planning/
/docs/tasks/*/state.json.*.tmp

# Execution worktrees and local runtime data
/.worktrees/
/.execution/
# Keep readable summaries; ignore screenshots, logs, state, reports, and copied inputs
/docs/tasks/*/execution/*/*
!/docs/tasks/*/execution/*/*.md

# JavaScript dependencies and logs
node_modules/
*.log

# macOS and editor-local files
.DS_Store
._*
*.swp
*.swo
*~
xcuserdata/
*.xcuserstate

# Local environment and signing credentials
.env
.env.*
!.env.example
!.env.sample
*.p12
*.pfx
*.key
*.pem
*.mobileprovision
*.provisionprofile

# Qlty links to its per-machine cache
/.qlty/logs
/.qlty/out
/.qlty/plugin_cachedir
/.qlty/results
